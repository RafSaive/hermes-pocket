# Copie ce fichier en .env et adapte les valeurs, puis lance ./deploy.sh
# ------------------------------------------------------------------------

# URL de l'API server de Hermes, joignable depuis l'hôte du proxy.
# (Active l'API server côté Hermes : voir README §1.)
HERMES_API=http://100.70.160.21:8642

# La clé Bearer configurée côté Hermes (API_SERVER_KEY).
HERMES_KEY=change-me

# Port sur lequel Hermes Pocket sera servi.
PORT=8095

# Nom du conteneur Docker.
CONTAINER=hermes-pocket
